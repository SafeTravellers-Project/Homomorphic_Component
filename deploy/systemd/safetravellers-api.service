[Unit]
Description=SAFETravellers API Service
After=network.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_USER>
WorkingDirectory=<PROJECT_PATH>/api
EnvironmentFile=<PROJECT_PATH>/api/.env
ExecStart=<PROJECT_PATH>/.venv/bin/python server.py
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
